# PostgreSQL 접속 문자열.
# 이 값이 설정되면 대시보드는 PostgreSQL에서 데이터를 읽고 쓴다.
# 비워두거나 .env 파일이 없으면 기존 CSV(data/processed/*.csv)로 자동 폴백한다.
#
# 사용법:
#   cp .env.example .env      (값을 실제로 채운 뒤 저장)
# docker compose 가 .env 를 자동으로 읽어 컨테이너에 전달한다.
# .env 는 git 에 커밋되지 않는다(.gitignore).

# ── (기본) WSL 도커 컨테이너 → Windows 호스트의 PostgreSQL ──
# WSL 컨테이너에서 Windows 호스트는 host.docker.internal 로 접근한다.
# 비밀번호/DB명/계정을 실제 값으로 바꾼다.
DATABASE_URL=postgresql+psycopg2://postgres:여기_비밀번호@host.docker.internal:5432/researcher_board

# SSL 이 필요하면 끝에 ?sslmode=require 를 붙인다(로컬/사내망은 보통 불필요):
# DATABASE_URL=postgresql+psycopg2://postgres:pw@host.docker.internal:5432/researcher_board?sslmode=require

# ── (대안) 도커 컨테이너 내 번들 postgres 를 쓸 경우 ──
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/researcher_board
#   이때는 db 도 함께 기동:  docker compose --profile bundled-db up -d

# ── (대안) WSL 안에서 직접 python app.py 로 실행할 때(도커 아님) ──
# DATABASE_URL=postgresql+psycopg2://postgres:pw@localhost:5432/researcher_board

# ── 로컬/온프레미스 LLM (OpenAI 호환 /v1/chat/completions) ──
# AI 검색(Text2SQL)과 코멘트 종합요약(pipeline/process_comments.py --llm)이
# 모두 이 설정을 사용한다. 무인증이면 LLM_API_KEY 를 비워둔다.
#
# (온프레미스 vllm) 사내에서 운영 중인 vllm 서버:
#   LLM_BASE_URL=http://<vllm호스트>:8000/v1
#
# (권장, ollama) WSL 에서 직접 실행한 ollama 를 앱 컨테이너가 사용:
#   - WSL 에서:  export OLLAMA_HOST=0.0.0.0:11434  후  ollama serve
#   - host.docker.internal(=172.17.0.1) 은 컨테이너에서 본 WSL 호스트
LLM_BASE_URL=http://host.docker.internal:11434/v1
#
# (대안) ollama 도커 컨테이너:  docker compose --profile llm up -d
#   LLM_BASE_URL=http://ollama:11434/v1
# (대안) 도커 없이 python app.py:  LLM_BASE_URL=http://localhost:11434/v1

# 모델명은 `ollama list` 에 뜨는 정확한 이름을 넣는다.
LLM_MODEL=qwen3.5:4b
# GPU 환경이면 큰 코더 모델이 SQL 정확도↑ :  LLM_MODEL=qwen3-coder:30b
# LLM_API_KEY=ollama          # 로컬은 대개 불필요(더미)
# LLM_TIMEOUT=60
