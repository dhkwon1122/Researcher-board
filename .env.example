# PostgreSQL 접속 문자열.
# 이 값이 설정되면 대시보드는 PostgreSQL에서 데이터를 읽고 쓴다.
# 비워두거나 .env 파일이 없으면 기존 CSV(data/processed/*.csv)로 자동 폴백한다.
#
# 사용법:
#   cp .env.example .env      (값을 실제로 채운 뒤 저장)
# docker compose 가 .env 를 자동으로 읽어 컨테이너에 전달한다.
# .env 는 git 에 커밋되지 않는다(.gitignore).

# 포트는 기본 5433 — 운영 서버에 이미 5432로 떠 있는 기존 PostgreSQL(손대지
# 않음)과 충돌하지 않도록, 이 앱 전용 PostgreSQL은 5433으로 띄운다(도커 번들
# db 컨테이너/Windows 네이티브 설치 모두 5433으로 리스닝하도록 맞출 것 —
# docs/database.md 참고).

# ── (기본) WSL 도커 컨테이너 → Windows 호스트의 PostgreSQL ──
# WSL 컨테이너에서 Windows 호스트는 host.docker.internal 로 접근한다.
# 비밀번호/DB명/계정을 실제 값으로 바꾼다.
DATABASE_URL=postgresql+psycopg2://postgres:여기_비밀번호@host.docker.internal:5433/researcher_board

# SSL 이 필요하면 끝에 ?sslmode=require 를 붙인다(로컬/사내망은 보통 불필요):
# DATABASE_URL=postgresql+psycopg2://postgres:pw@host.docker.internal:5433/researcher_board?sslmode=require

# ── (대안) 도커 컨테이너 내 번들 postgres 를 쓸 경우 ──
# 컨테이너 안에서는 도커 네트워크 내부 포트(항상 5432)로 접근 — 호스트에
# 노출되는 5433(docker-compose.yml의 db 서비스 ports)과는 별개다.
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/researcher_board
#   이때는 db 도 함께 기동:  docker compose --profile bundled-db up -d
#
#   번들 db 컨테이너 자체의 비밀번호는 docker-compose.yml이 이 값을 그대로
#   읽어 POSTGRES_PASSWORD로 넘긴다 — 비워두면(또는 .env가 없으면) 개발용
#   기본값 "postgres"로 뜬다. 운영/외부 노출 환경에서는 반드시 채우고, 위
#   DATABASE_URL의 비밀번호도 반드시 같은 값으로 맞출 것(둘이 따로 놀면
#   컨테이너 자체 비밀번호와 앱이 접속에 쓰는 비밀번호가 어긋난다).
# POSTGRES_PASSWORD=여기_비밀번호

# ── (대안) WSL 안에서 직접 python app.py 로 실행할 때(도커 아님) ──
# DATABASE_URL=postgresql+psycopg2://postgres:pw@localhost:5433/researcher_board

# ── LLM2: 사내 채팅형 LLM (thinkingcap) — 배치 파이프라인 + AI 자연어 검색 +
#          코멘트 종합요약이 전부 이 설정 하나로 통일 ──
# pipeline/llm_client.py(call_llm())가 사용 — 전문성 분석/유사도 등 배치
# 스크립트 대부분, 화면의 자연어 질문 기능(services/nl_query.py,
# services/open_data_query.py), 코멘트 종합요약(pipeline/process_comments.py
# --llm)이 전부 여기로 몰린다. 예전엔 코멘트 종합요약만 별도로
# services/llm.py의 자체 chat()/LLM_BASE_URL 설정(동시 호출 제한·재시도 없음)을
# 썼는데, 결국 같은 사내 LLM 서버를 가리키는 중복 설정이라 이쪽으로 합치고
# services/llm.py는 임베딩 전용으로 정리했다(아래 EMBED_* 참고). 또한
# 예전에는 이 LLM2_* 설정이 pipeline/llm_config.py 라는 별도 파일(.env 와
# 따로 관리)에 있었지만, 비밀값을 담는 파일이 두 곳으로 나뉠 이유가 없어
# 이 .env 하나로 합쳤다. 인증/별도 헤더가 필요 없는 단순 OpenAI 호환
# 엔드포인트를 가정한다.
LLM2_API_URL=http://75.12.15.121:8000/v1/chat/completions
LLM2_MODEL=thinkingcap
# LLM2_TIMEOUT=300                    # 초
#
# thinkingcap처럼 최종 답변 전에 사고 과정(reasoning)에도 토큰을 쓰는 모델은
# max_tokens가 부족하면 사고 과정만 쓰다 끝나 답변(JSON 등)을 못 내는 경우가
# 있다. 호출 시 요청한 max_tokens에 이 배수를 곱해 여유를 준다.
# LLM2_MAX_TOKENS_MULTIPLIER=3
#
# thinkingcap은 전용 vLLM 서버(예: RTX PRO 6000 Blackwell 96GB 1장)에서 서빙되는
# 것을 전제로, 시간 기반 간격 대신 "동시 호출 허용 개수"로 부하를 조절한다.
# vLLM은 continuous batching으로 여러 요청을 한꺼번에 배치 처리하므로, 순차
# 호출보다 동시에 여러 건을 보내는 편이 훨씬 효율적이다. 실제 안전한 값은
# 모델 크기/양자화, 프롬프트 길이, vLLM 자체 설정(--max-num-seqs 등)에 따라
# 달라지므로 반드시 실측으로 조정할 것(8~16 정도로 시작 권장).
# LLM2_MAX_CONCURRENT=8
#
# "보유 전문성" 탭의 자연어 질문 기능처럼 사용자가 화면에서 실시간으로 응답을
# 기다리는 호출은, 배치 파이프라인이 LLM2_MAX_CONCURRENT 슬롯을 모두 쓰고 있을
# 때 무한정 대기하면 화면이 멈춘 것처럼 보인다. 이 시간(초) 안에 슬롯을 못
# 얻으면 즉시 실패로 처리해 "지금은 바쁘다"는 안내를 보여준다(배치 스크립트는
# 기존처럼 무한 대기).
# LLM2_QUERY_MAX_WAIT_SECONDS=15
#
# ReadTimeout/연결 오류 시 자동 재시도 횟수와 백오프 시작 시간(초, 회차마다
# 2배씩 증가). 사내 LLM API 호출이 불안정할 때 값을 더 늘려도 된다.
# LLM_MAX_RETRIES=5
# LLM_RETRY_BACKOFF=5.0

# ── 사내 Confluence 접속 정보 (개인 액세스 토큰, PAT 방식) ──
# pipeline/confluence_client.py가 사용(과제 문서 조회). base URL은 별도로
# 설정하지 않고, project_confl_address.csv의 각 행 confl_address(컨플루언스
# 페이지 URL)에서 그때그때 추출해서 사용한다. 미설정이어도 되지만, 그 경우
# confl_address가 있는 과제는 PDF 폴백(data/raw/conflue_MPR/)이 없으면
# 파이프라인에서 건너뛰어진다.
# CONFLUENCE_TOKEN=your-confluence-personal-access-token
# CONFLUENCE_ALLOWED_HOSTS=samsungds.net,samsung.net

# ── BGE-M3 임베딩 서버 (services/llm.py의 embed()) ──
# LLM2와는 다른 서버/포트 — 사내망 제한으로 ollama에 BGE-M3를 설치할 수
# 없어 별도의 로컬 python 서버(services/bge_server.py, pipeline/embed_server.py)
# 를 쓴다. 전문성 유사도/매칭(pipeline/researcher_fit.py의 cached_embed 등),
# Job Market 화면 전반이 사용 — 이 서버에 연결이 안 되면 Job Market이
# "로컬 임베딩 서버에 연결할 수 없습니다" 에러를 낸다.
#
# EMBED_BASE_URL의 값은 "이 앱이 어디서 실행되는지"에 따라 달라진다:
#   - docker compose로 앱을 띄우고 bge-embed도 같이 띄웠으면(아래) 기본값
#     그대로(http://bge-embed:7138, docker-compose.yml의 app 서비스 환경
#     변수 참고) 둔다 — 이 .env 파일에서 EMBED_BASE_URL을 아예 안 건드리는
#     게 정상.
#   - 앱은 컨테이너 밖(로컬 python app.py)에서 띄우고 bge_server.py만
#     별도로 실행 중이면 EMBED_BASE_URL=http://localhost:7138(기본값).
#   - 앱은 컨테이너 안, bge_server.py는 호스트에서 직접 실행 중이면
#     EMBED_BASE_URL=http://host.docker.internal:7138.
#
# bge-embed를 docker compose로 띄우려면(별도 컨테이너, 기본으로는 안 뜸 —
# torch/FlagEmbedding이 무거워 앱 이미지와 분리했다, Dockerfile.embed 참고):
#   docker compose --profile embed up -d bge-embed
# GPU(CUDA)로 띄우려면 docker-compose.gpu.yml 오버레이(Dockerfile.embed의
# TORCH_INDEX_URL 빌드 인자 설명 참고).
# EMBED_BASE_URL=http://bge-embed:7138
# EMBED_MODEL=bge-m3
# EMBED_API_KEY=여기_긴_랜덤값  # Docker 임베딩 서버는 필수
# EMBED_TIMEOUT=300             # 초 — CPU 추론 시 배치당 오래 걸릴 수 있어 넉넉하게

# ── 사내 메일 발송 REST API (pipeline/mailer.py) ──
# 일부 리포트(예: process_project_expertise.py의 "과제 전문성 분석")를 앱
# 밖으로 공유해야 할 때, data/processed/에 완성된 HTML 파일을 남기지 않고
# 그때그때 만들어 메일로만 보낸다(--email 옵션, 각 스크립트 상단 사용법
# 참고). SMTP가 아니라 사내 메일 발송 REST API를 호출한다(POST
# {MAIL_API_URL}/mails/send?userId={MAIL_USER_ID}, Bearer 토큰 인증).
# TLS 검증은 기본 활성화된다. 사내 루트 CA가 필요하면 MAIL_CA_BUNDLE을 지정한다.
# MAIL_API_URL은 base URL만 넣는다 — /mails/send 경로는 코드가 붙인다.
# MAIL_API_URL=https://mail.internal.example.com
# MAIL_TOKEN=your-bearer-token
# MAIL_SYSTEM_ID=your-system-id
# MAIL_FROM=researcher-board@example.com
# MAIL_USER_ID=people.sait      # 기본값 — 보통 건드릴 필요 없음
# MAIL_TIMEOUT=30                # 초 — API 응답이 느려 타임아웃이 자주 나면 늘릴 것
# MAIL_VERIFY_TLS=true
# MAIL_CA_BUNDLE=/run/secrets/internal-ca.pem

# ── 웹/세션 보안 ──
# TLS 리버스 프록시(HTTPS) 뒤에서 운영할 때만 true — 지금처럼 사내망에
# 평문 HTTP로 직접 노출하는 운영 전환 전 단계에서는 반드시 false로 둘 것.
# true인 채로 HTTPS 없이 쓰면 브라우저가 세션 쿠키를 보내지 않아 로그인이
# 조용히 실패한다. TLS 앞단(deploy/nginx.conf, --profile proxy 또는 사내
# 리버스 프록시)을 세우면 그때 true로 바꾼다.
SESSION_COOKIE_SECURE=false
# app 컨테이너 바로 앞에 신뢰 가능한 리버스 프록시가 정확히 N홉 있을 때만
# N으로 설정한다(app.py 참고) — X-Forwarded-For/-Proto를 신뢰해 실제
# 클라이언트 IP/스킴을 복원한다. 0(기본값)이면 신뢰하지 않고
# request.remote_addr을 그대로 쓴다. 리버스 프록시 없이 앱을 직접 노출하는
# 구성에서 이 값을 켜면 클라이언트가 헤더를 위조해 IP 기반 rate limit/로그를
# 속일 수 있으므로 절대 켜지 말 것.
# docker-compose.yml의 reverse-proxy(nginx, --profile proxy)를 쓴다면 그게
# 유일한 진입점인 한 1로 설정한다 — 인증서 준비는 certs/README.md,
# scripts/gen_self_signed_cert.sh 참고.
TRUSTED_PROXY_COUNT=0
# 로그인 실패 제한(기본 15분 동안 IP별/계정별 각각 5회). DATABASE_URL이
# 설정돼 있으면 카운터를 PostgreSQL에 기록해 gunicorn 다중 워커·다중 컨테이너
# 배포에서도 공유되게 한다(services/login_throttle.py) — DB가 없으면(로컬
# 단일 프로세스 개발) 메모리로 폴백한다.
LOGIN_WINDOW_SECONDS=900
LOGIN_MAX_FAILURES=5
# 비밀번호 정책(2026-08-31 변경) — 영문자/숫자/특수문자 3종류 모두 필수,
# 길이는 MIN~MAX자 범위(기본 8~12, 최대값도 강제). services/auth.py
# password_validation_error() 참고.
MIN_PASSWORD_LENGTH=8
MAX_PASSWORD_LENGTH=12
# PostgreSQL 운영 배포의 /setup은 기본 차단. 최초 계정은 bulk_create_users.py 사용.
ENABLE_WEB_SETUP=false
# Flask가 받을 수 있는 단일 요청 크기(기본 10 MiB).
MAX_CONTENT_LENGTH=10485760
# 업로드 원본 및 문서 파싱 제한
MAX_UPLOAD_BYTES=8388608
MAX_PDF_PAGES=100
MAX_DOCUMENT_CHARS=500000
# 자연어 SQL 실행 자원 제한
DUCKDB_MEMORY_LIMIT_MB=512
DUCKDB_THREADS=2
# 임베딩 API 요청 제한
EMBED_MAX_ITEMS=64
EMBED_MAX_CHARS_PER_ITEM=8000
EMBED_MAX_TOTAL_CHARS=65536
